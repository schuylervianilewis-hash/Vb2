<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EAED"
    android:orientation="vertical">

    <!-- Category Pill Strip (replaces suggestion bar entirely) -->
    <HorizontalScrollView
        android:id="@+id/hsvCategoryTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#E8EAED"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llCategoryTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D1D5DB" />

    <!-- Emoji Glyphs Grid Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmojiGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="4dp"
        android:scrollbars="vertical" />

    <!-- Unified 4-Button Modal Bottom Bar -->
    <com.example.ime.modal.ModalBottomBarView
        android:id="@+id/modalBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
