<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← Back"
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:background="#E2E8F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Appearance"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:background="#FFFFFF" />
    </LinearLayout>

    <!-- Interactive Live Keyboard Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E2E8F0"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE PREVIEW"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp" />

        <com.example.ime.keyboard.VianKeyboardView
            android:id="@+id/livePreviewKeyboard"
            android:layout_width="match_parent"
            android:layout_height="240dp" />
    </LinearLayout>

    <!-- Sliders ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Key Height -->
            <TextView
                android:id="@+id/tvHeightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Key Height: 46 dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekKeyHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="35"
                android:progress="11"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 2. Key Corner Radius -->
            <TextView
                android:id="@+id/tvRadiusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corner Radius: 8 dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekCornerRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="24"
                android:progress="8"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 3. Horizontal Gap -->
            <TextView
                android:id="@+id/tvHGapLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horizontal Gap: 4 dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekHGap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="12"
                android:progress="4"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 4. Vertical Gap -->
            <TextView
                android:id="@+id/tvVGapLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vertical Gap: 5 dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekVGap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="14"
                android:progress="5"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 5. Special Keys Grey Tone -->
            <TextView
                android:id="@+id/tvActionGrayLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Special Keys Grey: 40%"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekActionGray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="40"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- 6. Enter Key Color -->
            <TextView
                android:id="@+id/tvEnterColorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter Key Color: 50%"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekEnterColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
